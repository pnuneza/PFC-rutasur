# ==========================================================
# RutaSur v1.0 — variables de entorno
# Copie este archivo como .env y cambie las contraseñas.
# El archivo .env NUNCA se sube al repositorio (.gitignore).
# ==========================================================

# --- Base de datos local (Docker) ---
POSTGRES_DB=rutasur
POSTGRES_USER=rutasur_owner
POSTGRES_PASSWORD=cambie_esta_clave_del_dueno
DB_PORT=5432

# Contraseña del rol con permisos mínimos que usa el backend
RUTASUR_APP_PASSWORD=cambie_esta_clave_de_la_app

# "si" carga los datos de demostración la primera vez; "no" deja la base vacía
RUTASUR_CARGAR_DEMO=si

# ==========================================================
# RutaSur API — variables de entorno del backend
# Copie este archivo como backend/.env y ajuste la contraseña.
# El archivo .env NUNCA se sube al repositorio.
# ==========================================================

# Conexión con el rol de permisos mínimos (rutasur_app).
# La contraseña es la de RUTASUR_APP_PASSWORD del .env de la raíz.
DATABASE_URL=postgresql+psycopg://rutasur_app:cambie_esta_clave_de_la_app@localhost:5432/rutasur

# Dominios que pueden llamar a la API desde un navegador (panel web), en formato JSON
CORS_ORIGENES=[]

ENTORNO=desarrollo

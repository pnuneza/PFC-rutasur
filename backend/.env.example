# ==========================================================
# RutaSur API — variables de entorno del backend
# Copie este archivo como backend/.env y ajuste la contraseña.
# El archivo .env NUNCA se sube al repositorio.
# ==========================================================

# Conexión con el rol de permisos mínimos (rutasur_app).
# La contraseña es la de RUTASUR_APP_PASSWORD del .env de la raíz.
DATABASE_URL=postgresql+psycopg://rutasur_app:cambie_esta_clave_de_la_app@localhost:5432/rutasur

# Grupo de conexiones a la base. La suma de ambos es también el máximo de
# peticiones que consultan la base a la vez (D-11). Neon gratuito: no subir de 10.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_S=10

# Dominios que pueden llamar a la API desde un navegador (panel web), en formato JSON
CORS_ORIGENES=[]

ENTORNO=desarrollo

# Clave de firma de los tokens JWT. En desarrollo puede omitirse (usa una de prueba);
# en producción es obligatoria, de 32 caracteres o más, y la genera Render.
# JWT_SECRETO=

# RN-012: días de historial de posiciones, sesiones cerradas y eventos.
# La depuración corre sola en producción; en desarrollo se activa con true.
RETENCION_DIAS=30
# DEPURACION_AUTOMATICA=true
